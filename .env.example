# Copie para .env (fora do git) e ajuste. Usado pelo docker-compose.yml para subir o ambiente local.
POSTGRES_DB=apartamento
POSTGRES_USER=user_app_nord
POSTGRES_PASSWORD=troque-esta-senha-local

# Chave JWT do ambiente docker (base64 de 32+ bytes). Gere com: openssl rand -base64 48
NORD_JWT_KEYS=local:COLE_AQUI_A_CHAVE_BASE64
NORD_JWT_ACTIVE_KID=local

# Primeiro ADMIN (só é criado com a tabela usuario vazia). Senha: 10 caracteres a 72 bytes.
NORD_ADMIN_EMAIL=
NORD_ADMIN_NAME=
NORD_ADMIN_PASSWORD=

NORD_CORS_ORIGINS=http://localhost:5173
